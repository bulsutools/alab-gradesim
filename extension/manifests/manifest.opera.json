{
  "manifest_version": 3,
  "name": "ALAB GradeSim",
  "version": "2.1.0",
  "description": "BulSU GWA calculator and Latin honors simulator, with a planner for your remaining courses. Reads grades from ALAB SMS; your data stays on your device.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://amis.uplb.edu.ph/*",
    "https://api-amis.uplb.edu.ph/*",
    "https://alabsms.bulsu.edu.ph/*",
    "https://alabsms-server.bulsu.edu.ph/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://amis.uplb.edu.ph/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://alabsms.bulsu.edu.ph/*"
      ],
      "js": [
        "alab-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://gradesim.uplb.tools/*"
    ]
  }
}
